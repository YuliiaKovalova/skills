<Project DefaultTargets="Build">
  <Target Name="ResolveBuildInputs">
    <Error Condition="!Exists('required-settings.json')"
           Code="BLD1001"
           Text="The code generation input required-settings.json is missing." />
  </Target>
  <Target Name="GenerateCode" DependsOnTargets="ResolveBuildInputs">
    <Message Importance="High" Text="Inputs resolved." />
  </Target>
  <Target Name="Build" DependsOnTargets="GenerateCode" />
</Project>
