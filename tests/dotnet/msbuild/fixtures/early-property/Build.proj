<Project DefaultTargets="Build">
  <Import Project="Directory.Build.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <Import Project="Directory.Build.targets" />
  <Target Name="Build">
    <Error Condition="'$(DefineConstants)' != 'BASE;NET10_FEATURE'"
           Code="EVAL1001" Text="The framework-specific constant is missing." />
    <Error Condition="'@(FeatureMarker)' != 'valid-item'"
           Code="EVAL1002" Text="The working framework-specific item was lost." />
    <Message Importance="High" Text="CONSTANTS=$(DefineConstants) ITEMS=@(FeatureMarker)" />
  </Target>
</Project>
