<Project DefaultTargets="Build">
  <PropertyGroup>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>
  <Target Name="Generate">
    <Message Importance="High" Text="GENERATION_EXECUTED" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ReadLinesFromFile File="message.txt">
      <Output TaskParameter="Lines" ItemName="MessageLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(IntermediateOutputPath)message.txt"
                      Lines="@(MessageLines)"
                      Overwrite="true" />
  </Target>
  <Target Name="Build" DependsOnTargets="Generate" />
  <Target Name="Clean">
    <Delete Files="$(IntermediateOutputPath)message.txt" />
  </Target>
</Project>
